# Stack env for production. Copy to
# /volume1/docker/beboer.denkglfamilie.dk/production/production.env (0640 root:docker).
# Loopback port the DSM reverse-proxy vhost for beboer.denkglfamilie.dk points at.
HUMHUB_PORT=
# Production is the stack that ran before this repository existed, so its
# data stays where it is. The layout below it is humhub/{uploads,assets,
# modules,themes,config,php-pages} and db/data.
DATA_DIR=/volume1/docker/<the directory the current beboer compose binds>
DB_ROOT_PASSWORD=
# The installation was created as root. Keep that until a least-privilege
# user has been granted on the database.
DB_USER=root
DB_PASSWORD=
