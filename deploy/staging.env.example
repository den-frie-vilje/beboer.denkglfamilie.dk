# Stack env for staging. Copy to
# /volume1/docker/beboer.denkglfamilie.dk/staging/staging.env (0640 root:docker).
# Loopback port the DSM reverse-proxy vhost for beboer-denkglfamilie-dk.stage.denfrievilje.dk points at.
HUMHUB_PORT=18091
# Loopback port of the mail catcher's web UI (every mail staging sends).
MAILCATCHER_PORT=18092
DATA_DIR=/volume1/docker/beboer.denkglfamilie.dk/staging/data
# When production is not running, the refresh copies its database files as
# they are, so this must equal production's. A running production is dumped
# and the staging database recreated from the dump, so any value works.
DB_ROOT_PASSWORD=
DB_USER=root
DB_PASSWORD=
