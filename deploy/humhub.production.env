# HumHub's own .env, read by HumHub for the web and the console application
# (index.php and protected/yii load it from the web root). Mounted from the
# repository, so it is the record of this environment's configuration.
#
#   HUMHUB_CONFIG__<PATH>          config for both applications
#   HUMHUB_WEB_CONFIG__<PATH>      config for the web application only
#   HUMHUB_FIXED_SETTINGS__<MODULE>__<NAME>
#                                  pins a database setting: it wins over the
#                                  value in the setting table and is locked in
#                                  the admin interface
#
# Path segments are joined with __, upper case with underscores, and become
# camelCase (TRUSTED_HOSTS is trustedHosts). Values are JSON when they parse
# as JSON, otherwise strings.

# DSM's reverse proxy reaches the stack through the Docker bridge, so the
# X-Forwarded headers it sets are trusted from the Docker address range.
HUMHUB_WEB_CONFIG__COMPONENTS__REQUEST__TRUSTED_HOSTS='["172.16.0.0/12"]'
