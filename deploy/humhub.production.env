# HumHub's own .env, read by HumHub for the web and the console application
# (index.php and protected/yii load it from the web root). Mounted from the
# repository, so it is the record of this environment's configuration.
#
#   HUMHUB_CONFIG__<PATH>          config for both applications
#   HUMHUB_WEB_CONFIG__<PATH>      config for the web application only
#   HUMHUB_FIXED_SETTINGS__<MODULE>__<NAME>
#                                  pins a database setting: it wins over the
#                                  value in the setting table and is locked in
#                                  the admin interface
#
# Path segments are joined with __, upper case with underscores, and become
# camelCase (TRUSTED_HOSTS is trustedHosts). Values are JSON when they parse
# as JSON, otherwise strings.

# DSM's reverse proxy reaches the stack through the Docker bridge, so the
# X-Forwarded headers it sets are trusted from the Docker address range.
HUMHUB_WEB_CONFIG__COMPONENTS__REQUEST__TRUSTED_HOSTS='["172.16.0.0/12"]'

# The one rule the retired Kongeligt theme carried, pinned as the custom SCSS.
HUMHUB_FIXED_SETTINGS__BASE__THEME_CUSTOM_SCSS='.login-container #img-logo { max-width: 300px !important; }'

# Appearance colours, pinned. The 1.18 upgrade copies a theme's colours into
# Appearance only when it finds the theme at migration time; this stack mounts
# no theme folder, so the Kongeligt values are pinned here, with the primary
# changed to rgb(29, 48, 75) (Ole, 2026-10-21). Each colour applies only with
# its use-default flag off, which is how HumHub's theme build reads them.
HUMHUB_FIXED_SETTINGS__BASE__THEME_PRIMARY_COLOR='#1d304b'
HUMHUB_FIXED_SETTINGS__BASE__USE_DEFAULT_THEME_PRIMARY_COLOR=false
HUMHUB_FIXED_SETTINGS__BASE__THEME_ACCENT_COLOR='#6fdbe8'
HUMHUB_FIXED_SETTINGS__BASE__USE_DEFAULT_THEME_ACCENT_COLOR=false
HUMHUB_FIXED_SETTINGS__BASE__THEME_SUCCESS_COLOR='#97d271'
HUMHUB_FIXED_SETTINGS__BASE__USE_DEFAULT_THEME_SUCCESS_COLOR=false
HUMHUB_FIXED_SETTINGS__BASE__THEME_WARNING_COLOR='#fdd198'
HUMHUB_FIXED_SETTINGS__BASE__USE_DEFAULT_THEME_WARNING_COLOR=false
HUMHUB_FIXED_SETTINGS__BASE__THEME_DANGER_COLOR='#ff8989'
HUMHUB_FIXED_SETTINGS__BASE__USE_DEFAULT_THEME_DANGER_COLOR=false
HUMHUB_FIXED_SETTINGS__BASE__THEME_LIGHT_COLOR='#ededed'
HUMHUB_FIXED_SETTINGS__BASE__USE_DEFAULT_THEME_LIGHT_COLOR=false
