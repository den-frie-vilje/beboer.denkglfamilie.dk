# HumHub 1.18.6. Bump both Dockerfiles together; the branch decides the environment
# (staging builds from the staging branch, production from main).
# The digest is the manifest-list digest Docker Hub shows for the tag.
# The stack that ran before this repository was 1.15.2, whose image is no
# longer published; 1.15.6 is the last 1.15, so onboarding production to the
# agent is a patch update.
FROM docker.io/jeremyvies/humhub:1.18.6-phponly@sha256:a7a6bc1ecd6dcfe6ecab13b595e80ca34899d6dfd4fdd1efed820c7120fab935
